"""test_worker_profile.py - 超级个体档案管理接口测试"""
import pytest
from .test_base import TestBase


EXISTING_WORKER_NO = "000000044"


class TestWorkerProfile(TestBase):
    @pytest.mark.smoke
    def test_page_worker_profile(self):
        """分页查询超级个体档案，应返回成功及分页结构"""
        response = self.client.post("/platform/workerProfile/page", json={"pageNum": 1, "pageSize": 10})
        self.validator.assert_status_code(response, 200)
        data = response.json()
        assert data.get("code") in ("0", "200", 0, 200, None) or data.get("success") is True
        payload = data.get("result") or data.get("data") or {}
        assert "records" in payload or "list" in payload

    def test_detail_worker_profile_existing(self):
        """查询存在的超级个体详情，应返回成功"""
        response = self.client.get(f"/platform/workerProfile/detail/{EXISTING_WORKER_NO}")
        self.validator.assert_status_code(response, 200)
        data = response.json()
        assert data.get("result") or data.get("data")

    def test_detail_worker_profile_not_found(self):
        """查询不存在的超级个体，应返回失败或空数据"""
        response = self.client.get("/platform/workerProfile/detail/NON_EXISTENT_999")
        self.validator.assert_status_code(response, 200)

    def test_contracts_worker_profile(self):
        """查询超级个体合同列表，应返回成功"""
        response = self.client.get(f"/platform/workerProfile/contracts/{EXISTING_WORKER_NO}")
        self.validator.assert_status_code(response, 200)

    def test_assignment_records_worker_profile(self):
        """查询超级个体历史指派记录，应返回成功"""
        response = self.client.get(f"/platform/workerProfile/assignmentRecords/{EXISTING_WORKER_NO}")
        self.validator.assert_status_code(response, 200)

    def test_page_worker_profile_empty_keyword(self):
        """带空关键字分页查询，应返回成功"""
        response = self.client.post("/platform/workerProfile/page", json={"pageNum": 1, "pageSize": 5, "name": ""})
        self.validator.assert_status_code(response, 200)
