import pytest
from .test_base import TestBase

EXISTING_WORK_ORDER_ID = 2


class TestWorkOrder(TestBase):
    @pytest.mark.smoke
    def test_page_work_order(self):
        response = self.client.post("/platform/workOrder/page", json={"pageNum": 1, "pageSize": 10})
        self.validator.assert_status_code(response, 200)

    def test_detail_work_order(self):
        response = self.client.get(f"/platform/workOrder/detail?id={EXISTING_WORK_ORDER_ID}")
        self.validator.assert_status_code(response, 200)

    def test_assignments_work_order(self):
        response = self.client.get(f"/platform/workOrder/assignments?workOrderId={EXISTING_WORK_ORDER_ID}")
        self.validator.assert_status_code(response, 200)

    def test_page_work_order_empty(self):
        response = self.client.post("/platform/workOrder/page", json={"pageNum": 1, "pageSize": 5, "customerName": "NON_EXISTENT"})
        self.validator.assert_status_code(response, 200)
