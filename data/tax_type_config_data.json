  {
    "name": "add_success",
    "desc": "新增税种成功",
    "api": "add",
    "payload": {
      "taxTypeName": "${unique_tax_name}",
      "fixedDisplay": 0
    },
    "expect_success": true
  },
  {
    "name": "add_missing_name",
    "desc": "新增税种缺少税种名称",
