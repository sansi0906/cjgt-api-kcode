
import pytest
from .test_base import TestBase


class TestLoginProvider(TestBase):
    @pytest.mark.smoke
    def test_provider_login_success(self):
        response = self.client.login(
            username=self.config["provider_username"],
            password=self.config["provider_password"],
            login_type=self.config.get("login_type", 1),
            web_type=self.config.get("provider_web_type", 1),
        )
        self.validator.assert_status_code(response, 200)
        data = response.json()
        self.assert_login_success(data)

    def test_provider_login_invalid_password(self):
        response = self.client.login(
            username=self.config["provider_username"],
            password="wrong_pass",
            login_type=self.config.get("login_type", 1),
            web_type=self.config.get("provider_web_type", 1),
        )
        self.validator.assert_status_code(response, 200)
        data = response.json()
        self.assert_login_failure(data)

    def test_provider_login_invalid_username(self):
        response = self.client.login(
            username="wrong_provider",
            password=self.config["provider_password"],
            login_type=self.config.get("login_type", 1),
            web_type=self.config.get("provider_web_type", 1),
        )
        self.validator.assert_status_code(response, 200)
        data = response.json()
        self.assert_login_failure(data)

    def test_provider_login_empty_username(self):
        response = self.client.login(
            username="",
            password=self.config["provider_password"],
            login_type=self.config.get("login_type", 1),
            web_type=self.config.get("provider_web_type", 1),
        )
        self.validator.assert_status_code(response, 200)
        data = response.json()
        self.assert_login_failure(data)
