# GrlApiTest 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件不应提交到版本控制

# 服务地址
BASE_URL=http://your-server-ip:9200

# 测试账号（管理后台）
TEST_USERNAME=your_admin_phone
TEST_PASSWORD=your_admin_password
TEST_LOGIN_TYPE=1
TEST_WEB_TYPE=0

# 测试账号（服务商后台）
TEST_PROVIDER_USERNAME=your_provider_phone
TEST_PROVIDER_PASSWORD=your_provider_password
TEST_PROVIDER_WEB_TYPE=1

# 已禁用账号（管理后台，status=0，用于验证禁用态登录失败）
TEST_DISABLED_ADMIN_USERNAME=your_disabled_admin_phone
TEST_DISABLED_ADMIN_PASSWORD=your_disabled_admin_password

# 已禁用账号（服务商后台，status=0）
TEST_DISABLED_PROVIDER_USERNAME=your_disabled_provider_phone
TEST_DISABLED_PROVIDER_PASSWORD=your_disabled_provider_password

# 已删除账号（delete_status=1，逻辑删除态登录失败；该数据会被业务侧清理，缺失时用例会自动补建）
TEST_DELETED_ADMIN_USERNAME=your_deleted_admin_phone
TEST_DELETED_ADMIN_PASSWORD=your_deleted_admin_password

# MySQL 数据库配置（163：存放测试用例、执行结果等框架数据）
DB_HOST=your_db_host
DB_PORT=3307
DB_NAME=test_cjgt
DB_USER=root
DB_PASSWORD=your_db_password

# PostgreSQL 数据库配置（165：被测系统业务库）
PG_HOST=your_pg_host
PG_PORT=5432
PG_NAME=cjgt
PG_USER=postgres
PG_PASSWORD=your_pg_password

# PostgreSQL 清理 UUID（用于清理被测系统中由测试账号创建的数据）
PG_CLEANUP_UUID=your-cleanup-uuid
